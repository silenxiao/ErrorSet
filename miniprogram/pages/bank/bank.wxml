<page-meta page-style="{{illustrationPreviewUrl ? 'overflow: hidden;' : ''}}" />
<!-- 科目筛选 chips -->
<view wx:if="{{subjectTags.length > 0}}" class="filter-wrap">
  <view class="filter-row">
    <text class="filter-tag {{subjectFilter === null ? 'active' : ''}}" data-name="" bindtap="onFilterTap">全部 {{totalAll}}</text>
    <text
      wx:for="{{subjectTags}}"
      wx:key="name"
      class="filter-tag {{subjectFilter === item.name ? 'active' : ''}}"
      data-name="{{item.name}}"
      bindtap="onFilterTap"
    >{{item.name}} {{item.count}}</text>
  </view>
</view>

<view class="page-wrap">
  <view wx:if="{{error && error !== 'empty'}}" class="err-box">
    <view class="err-msg">加载失败：{{error}}</view>
    <view class="err-hint">后端地址：{{backendBase}}（请确认后端已启动，且开发者工具已勾选「不校验合法域名」）</view>
    <view class="text-btn danger" bindtap="retry">点击重试</view>
  </view>

  <view wx:if="{{loading && rows.length === 0}}" class="muted" style="padding:20rpx 0;">加载中…</view>
  <view wx:if="{{!loading && !error && rows.length === 0}}" class="empty card">
    <view class="ico ico-inbox"></view>
    <view class="muted">暂无错题，去识别结果页把题目加入错题库吧</view>
  </view>
  <view wx:if="{{!loading && rows.length > 0 && visibleRows.length === 0}}" class="empty card">
    <view class="ico ico-inbox"></view>
    <view class="muted">该科目下暂无错题</view>
  </view>

  <view wx:for="{{visibleRows}}" wx:key="id" class="wrow" data-id="{{item.id}}" bindtap="openDetail" hover-class="wrow-hover" hover-stay-time="80">
    <view class="whead">
      <text class="tag tag-subject" style="background:{{item.subjectColor}}1a;color:{{item.subjectColor}};" catchtap="editSubject" data-id="{{item.id}}" data-subject="{{item.subject}}">{{item.subject || '未设置'}}</text>
      <text class="muted">第 {{item.questionNo}} 题</text>
    </view>

    <view class="wtext">
      <md-render content="{{item.questionText || '—'}}"></md-render>
    </view>

    <view wx:if="{{item.illustrations.length > 0}}" class="ills" catchtap="noop">
      <image
        wx:for="{{item.illustrations}}"
        wx:for-item="ill"
        wx:key="id"
        class="ill-img"
        src="{{ill.imgUrl}}" data-url="{{ill.imgUrl}}" catchtap="onPreviewIllustration"
        mode="aspectFit"
        style="{{illSizes[item.id + '.' + ill.id]}}"
        data-key="{{item.id}}.{{ill.id}}"
        bindload="onIllLoad"
      ></image>
    </view>

    <view class="wactions" catchtap="noop">
      <view class="text-btn" data-id="{{item.id}}" bindtap="openDetail">详情</view>
      <view class="text-btn" data-id="{{item.id}}" data-position="top" catchtap="sort">置顶</view>
      <view class="text-btn" data-id="{{item.id}}" data-position="bottom" catchtap="sort">置底</view>
      <view class="text-btn danger" data-id="{{item.id}}" catchtap="del">删除</view>
      <view class="text-btn" data-id="{{item.id}}" data-result="correct" catchtap="mark"><view class="ico ico-like"></view>做对</view>
      <view class="text-btn" data-id="{{item.id}}" data-result="wrong" catchtap="mark"><view class="ico ico-dislike"></view>做错</view>
      <text class="muted wcount">做对 {{item.correctCount}} · 做错 {{item.wrongCount}}</text>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">
    <view wx:if="{{loading}}">加载中…</view>
    <view wx:else>加载更多</view>
  </view>
</view>

<!-- 科目编辑弹窗：只能从固定科目中选择 -->
<view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">编辑科目</view>
    <view class="field">
      <text class="label">选择科目</text>
      <picker mode="selector" range="{{subjectOptions}}" value="{{subjectOptions.indexOf(editValue)}}" bindchange="onSubjectPick">
        <view class="field-value picker">{{editValue || '未设置'}}<view class="ico ico-chev-down"></view></view>
      </picker>
    </view>
    <view class="dialog-btns">
      <button class="btn-ghost dlg-btn" hover-class="none" bindtap="closeEdit">取消</button>
      <button class="btn-primary dlg-btn" hover-class="none" bindtap="saveSubject">保存</button>
    </view>
  </view>
</view>

<illustration-preview src="{{illustrationPreviewUrl}}" bind:close="closeIllustrationPreview" />
