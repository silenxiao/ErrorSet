<view class="card">
  <view wx:if="{{subjectTags.length > 0}}" class="filter-row">
    <text class="filter-tag {{subjectFilter === null ? 'active' : ''}}" data-name="" bindtap="onFilterTap">全部 {{totalAll}}</text>
    <text
      wx:for="{{subjectTags}}"
      wx:key="name"
      class="filter-tag {{subjectFilter === item.name ? 'active' : ''}}"
      data-name="{{item.name}}"
      bindtap="onFilterTap"
    >{{item.name}} {{item.count}}</text>
  </view>

  <view wx:if="{{error && error !== 'empty'}}" class="err-box">
    <view class="err-msg">加载失败：{{error}}</view>
    <view class="err-hint">后端地址：{{backendBase}}（请确认后端已启动，且开发者工具已勾选「不校验合法域名」）</view>
    <view class="text-btn danger" bindtap="retry">点击重试</view>
  </view>

  <view wx:if="{{loading && rows.length === 0}}" class="muted" style="padding:20rpx 0;">加载中…</view>
  <view wx:if="{{!loading && !error && rows.length === 0}}" class="muted" style="padding:20rpx 0;">暂无错题，去识别结果页把题目加入错题库吧</view>
  <view wx:if="{{!loading && rows.length > 0 && visibleRows.length === 0}}" class="muted" style="padding:20rpx 0;">该科目下暂无错题</view>

  <view wx:for="{{visibleRows}}" wx:key="id" class="wrow">
    <view class="whead">
      <text class="tag" style="background:{{item.subjectColor}}1a;color:{{item.subjectColor}};" bindtap="editSubject" data-id="{{item.id}}" data-subject="{{item.subject}}">{{item.subject || '未设置'}}</text>
      <text class="muted">第 {{item.questionNo}} 题</text>
    </view>

    <view class="wtext">
      <md-render content="{{item.questionText || '—'}}"></md-render>
    </view>

    <view wx:if="{{item.illustrations.length > 0}}" class="ills">
      <image
        wx:for="{{item.illustrations}}"
        wx:for-item="ill"
        wx:key="id"
        class="ill-img"
        src="{{ill.imgUrl}}"
        mode="widthFix"
      ></image>
    </view>

    <view class="wactions">
      <view class="text-btn" data-id="{{item.id}}" bindtap="openDetail">详情</view>
      <view class="text-btn" data-id="{{item.id}}" data-position="top" bindtap="sort">置顶</view>
      <view class="text-btn" data-id="{{item.id}}" data-position="bottom" bindtap="sort">置底</view>
      <view class="text-btn danger" data-id="{{item.id}}" bindtap="del">删除</view>
      <view class="text-btn" data-id="{{item.id}}" data-result="correct" bindtap="mark">😀 做对</view>
      <view class="text-btn" data-id="{{item.id}}" data-result="wrong" bindtap="mark">😢 做错</view>
      <text class="muted" style="margin-left:auto;">做对 {{item.correctCount}} · 做错 {{item.wrongCount}}</text>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="more" bindtap="loadMore">
    <view wx:if="{{loading}}">加载中…</view>
    <view wx:else>加载更多</view>
  </view>
</view>

<!-- 科目编辑弹窗：只能从固定科目中选择 -->
<view wx:if="{{editVisible}}" class="mask" bindtap="closeEdit">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">编辑科目</view>
    <view class="field">
      <text class="label">选择科目</text>
      <picker mode="selector" range="{{subjectOptions}}" value="{{subjectOptions.indexOf(editValue)}}" bindchange="onSubjectPick">
        <view class="picker">{{editValue || '未设置'}}</view>
      </picker>
    </view>
    <view class="dialog-btns">
      <button class="btn-ghost dlg-btn" hover-class="none" bindtap="closeEdit">取消</button>
      <button class="btn-primary dlg-btn" hover-class="none" bindtap="saveSubject">保存</button>
    </view>
  </view>
</view>
