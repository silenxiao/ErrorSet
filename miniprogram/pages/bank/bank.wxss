/* 科目筛选标签行 */
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.filter-tag {
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e2e5ea;
  background: #fff;
  color: #555;
  font-size: 24rpx;
}

.filter-tag.active {
  background: #e6f4ff;
  border-color: #91caff;
  color: #1677ff;
}

.wrow {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.wrow:last-child {
  border-bottom: none;
}

.whead {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.wtext {
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-word;
}

.ills {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ill-img {
  width: 100%;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
}

.wactions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.more {
  text-align: center;
  color: #1677ff;
  padding: 24rpx 0;
  font-size: 26rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  background: #fff;
}

.input {
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.dlg-btn {
  flex: 1;
  margin: 0;
  border-radius: 10rpx;
  line-height: 72rpx;
  height: 72rpx;
  font-size: 28rpx;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .filter-row {
    gap: 7px;
    margin-bottom: 4px;
  }

  .filter-tag {
    padding: 3px 10px;
    border-radius: 5px;
    font-size: 12px;
  }

  .wrow {
    padding: 10px 0;
  }

  .whead {
    gap: 6px;
    margin-bottom: 5px;
  }

  .wtext {
    font-size: 13px;
  }

  .ills {
    margin-top: 6px;
    gap: 6px;
  }

  .ill-img {
    border-radius: 5px;
  }

  .wactions {
    gap: 8px;
    margin-top: 7px;
  }

  .more {
    padding: 12px 0;
    font-size: 13px;
  }

  .field {
    margin-bottom: 8px;
  }

  .label {
    width: 75px;
    font-size: 14px;
  }

  .picker,
  .input {
    padding: 6px 8px;
    font-size: 14px;
    border-radius: 6px;
  }

  .dialog {
    width: 480px;
    max-width: calc(100vw - 32px);
    padding: 16px;
    border-radius: 10px;
  }

  .dialog-title {
    font-size: 16px;
    margin-bottom: 10px;
  }

  .dialog-btns {
    gap: 10px;
    margin-top: 14px;
  }

  .dlg-btn {
    border-radius: 6px;
    line-height: 36px;
    height: 36px;
    font-size: 14px;
  }
}

