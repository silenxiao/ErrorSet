/* 页面容器：筛选行 + 卡片列表（错题每行一张白卡片，与 Web 端一致） */
.filter-wrap {
  padding: 20rpx 20rpx 0;
}

.page-wrap {
  padding: 20rpx;
}

/* 空状态复用 .card 时收窄外边距（外层已有 padding） */
.page-wrap .empty.card {
  margin: 0 0 20rpx;
}

.wrow {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 卡片按压反馈（极轻微，避免误读为可跳转整卡） */
.wrow-hover {
  background: #fcfcfd;
}

.whead {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.tag-subject {
  margin-right: 0;
}

.wtext {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-1);
  word-break: break-word;
}

.ills {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ill-img {
  /* 宽高由 bindload 计算的行内样式控制（按图片实际尺寸显示），此处只管外观 */
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  background: var(--bg);
}

.wactions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 14rpx;
  margin-left: -16rpx;
  flex-wrap: wrap;
}

.wcount {
  margin-left: auto;
}

.more {
  text-align: center;
  color: var(--primary);
  padding: 24rpx 0;
  font-size: 26rpx;
}

.field-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .filter-wrap {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    padding: 10px 10px 0;
    box-sizing: border-box;
  }

  .page-wrap {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    padding: 10px;
    box-sizing: border-box;
  }

  .wrow {
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 10px;
  }

  .whead {
    gap: 6px;
    margin-bottom: 5px;
  }

  .wtext {
    font-size: 13px;
  }

  .ills {
    margin-top: 6px;
    gap: 6px;
  }

  .ill-img {
    border-radius: 6px;
  }

  .wactions {
    gap: 2px;
    margin-top: 7px;
    margin-left: -8px;
  }

  .more {
    padding: 12px 0;
    font-size: 13px;
  }
}
