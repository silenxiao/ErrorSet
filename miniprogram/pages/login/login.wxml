<view class="login-page">
  <view class="login-card">
    <view class="login-head">
      <view class="ico ico-book-lg"></view>
    </view>
    <view class="login-title">AI 试卷识别与错题库</view>
    <view class="login-subtitle">{{mode === 'login' ? '登录后查看你的错题库' : '注册一个新账号'}}</view>

    <input
      class="login-input"
      placeholder="用户名"
      value="{{username}}"
      bindinput="onUsernameInput"
    />
    <input
      class="login-input"
      placeholder="密码（至少 6 位）"
      password
      value="{{password}}"
      bindinput="onPasswordInput"
    />
    <input
      wx:if="{{mode === 'register'}}"
      class="login-input"
      placeholder="确认密码（再次输入）"
      password
      value="{{confirmPassword}}"
      bindinput="onConfirmInput"
    />
    <picker
      wx:if="{{mode === 'register'}}"
      mode="selector"
      range="{{gradeOptions}}"
      value="{{gradeIndex}}"
      bindchange="onGrade"
    >
      <view class="login-input grade-picker">
        <text>孩子所在年级：{{gradeOptions[gradeIndex]}}</text>
        <view class="ico ico-chev-down"></view>
      </view>
    </picker>

    <button class="login-btn" loading="{{loading}}" bindtap="submit">
      {{mode === 'login' ? '登录' : '注册'}}
    </button>
    <view class="login-switch" bindtap="switchMode">
      {{mode === 'login' ? '没有账号？去注册' : '已有账号？去登录'}}
    </view>
  </view>
</view>
