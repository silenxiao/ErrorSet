.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #10265c 0%, #1677ff 100%);
  padding: 40rpx;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(16, 38, 92, 0.35);
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: #10265c;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin: 16rpx 0 48rpx;
}

.login-input {
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.login-btn {
  margin-top: 16rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.login-switch {
  margin-top: 32rpx;
  text-align: center;
  color: #1677ff;
  font-size: 26rpx;
}
