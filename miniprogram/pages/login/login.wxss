.login-page {
  min-height: 100vh;
  display: flex;
  /* 卡片靠上放置：输入用户名时键盘不会盖住密码框和登录按钮 */
  align-items: flex-start;
  justify-content: center;
  background: linear-gradient(135deg, #10265c 0%, #1677ff 100%);
  padding: 120rpx 40rpx 60rpx;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 12rpx 40rpx rgba(16, 38, 92, 0.35);
}

.login-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: #10265c;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin: 16rpx 0 48rpx;
}

.login-input {
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.login-btn {
  margin-top: 16rpx;
  background: #1677ff;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.login-switch {
  margin-top: 32rpx;
  text-align: center;
  color: #1677ff;
  font-size: 26rpx;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .login-page {
    padding: 48px 20px 24px;
  }

  .login-card {
    max-width: 320px;
    border-radius: 12px;
    padding: 30px 24px;
  }

  .login-title {
    font-size: 20px;
  }

  .login-subtitle {
    font-size: 13px;
    margin: 8px 0 24px;
  }

  .login-input {
    height: 44px;
    border-radius: 8px;
    padding: 0 12px;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .login-btn {
    margin-top: 8px;
    border-radius: 8px;
    font-size: 15px;
  }

  .login-switch {
    margin-top: 16px;
    font-size: 13px;
  }
}

