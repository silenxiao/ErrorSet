.user-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  background: #1677ff;
  color: #fff;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.user-info .username {
  font-size: 34rpx;
  font-weight: 600;
}

.user-info .muted {
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: #f9f9f9;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  color: #1f2329;
}

.menu-arrow {
  color: #a9aeb8;
  font-size: 40rpx;
  line-height: 1;
}
