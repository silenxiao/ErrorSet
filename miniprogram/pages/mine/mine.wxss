/* 用户卡：深蓝渐变圆角卡片（与 Web 端「我的」页一致） */
.user-card {
  display: flex;
  align-items: center;
  margin: 20rpx;
  padding: 48rpx 32rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, var(--primary-dark) 0%, var(--primary) 100%);
  color: #fff;
  box-shadow: var(--shadow-card);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info .username {
  font-size: 34rpx;
  font-weight: 600;
}

.user-info .user-sub {
  color: rgba(255, 255, 255, 0.75);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.grade-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--primary);
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .user-card {
    max-width: 720px;
    margin: 10px auto;
    width: 100%;
    box-sizing: border-box;
    padding: 24px 16px 16px;
    border-radius: 12px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    font-size: 22px;
    margin-right: 12px;
  }

  .user-info .username {
    font-size: 17px;
  }

  .user-info .user-sub {
    margin-top: 2px;
    font-size: 12px;
  }

  .grade-value {
    font-size: 14px;
  }
}
