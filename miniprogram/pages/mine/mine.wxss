.user-card {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  background: #1677ff;
  color: #fff;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.user-info .username {
  font-size: 34rpx;
  font-weight: 600;
}

.user-info .muted {
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: #f9f9f9;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  color: #1f2329;
}

.menu-arrow {
  color: #a9aeb8;
  font-size: 40rpx;
  line-height: 1;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .user-card {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
    padding: 24px 16px 16px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    font-size: 22px;
    margin-right: 12px;
  }

  .user-info .username {
    font-size: 17px;
  }

  .user-info .muted {
    margin-top: 2px;
  }

  .menu {
    padding: 0 12px;
  }

  .menu-item {
    padding: 14px 0;
  }

  .menu-icon {
    font-size: 18px;
    margin-right: 10px;
  }

  .menu-title {
    font-size: 15px;
  }

  .menu-arrow {
    font-size: 20px;
  }
}


.grade-value {
  font-size: 28rpx;
  color: #1677ff;
}
