/* 状态色来自 JS 计算的 statusColor / statusText / dateText，需在 wxml 中引用 */
.exam-card {
  display: flex;
  overflow: hidden;
  padding: 0;
}

.exam-accent {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 24rpx 0 0 24rpx;
}

.exam-main {
  flex: 1;
  padding: 24rpx;
  min-width: 0;
}

.exam-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.exam-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-pill {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.exam-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.meta-dot {
  color: var(--border);
}

.bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.bar-btn {
  margin: 0;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 28rpx;
  line-height: 64rpx;
  height: 64rpx;
}
.bar-btn::after {
  border: none;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title-row .count {
  font-size: 24rpx;
  font-weight: 400;
}

.tip {
  margin: 8rpx 0 16rpx;
  line-height: 1.5;
}

.field-col {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}

/* 纵向布局下 label 独占一行：覆盖全局 .label 的 150rpx 定宽，避免文案折行 */
.field-col .label {
  width: 100%;
}

.textarea {
  margin-top: 10rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-1);
  width: 100%;
  box-sizing: border-box;
  height: 140rpx;
}

/* 弹窗布局类：mask/dialog/dialog-btns/dlg-btn 已在 app.wxss 全局定义 */
.model-dlg-btn {
  flex: 0 0 auto;
  /* 不能太宽：会挤占同排「开始识别」按钮的平分空间，导致其文字折行 */
  max-width: 200rpx;
  padding: 0 20rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: block;
}

/* 编辑题目弹窗：固定高度，内容区用 scroll-view 独立滚动，底部按钮固定 */
.edit-dialog {
  width: 680rpx;
  height: 90vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.edit-scroll {
  flex: 1;
  min-height: 0;
}

/* auto-height 随内容增高，底部预留约一行空白 */
.edit-textarea {
  padding-bottom: 52rpx;
}

.edit-label {
  font-size: 24rpx;
  margin: 20rpx 0 8rpx;
}

.edit-preview {
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: var(--bg);
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-1);
  word-break: break-word;
}

.edit-ill {
  display: block;
  /* 宽高由 bindload 计算的行内样式控制（按图片实际尺寸显示），此处只管外观 */
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--border);
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .exam-accent {
    width: 4px;
    border-radius: 12px 0 0 12px;
  }

  .exam-main {
    padding: 12px;
  }

  .exam-head {
    gap: 8px;
  }

  .exam-title {
    font-size: 16px;
  }

  .status-pill {
    padding: 2px 9px;
    font-size: 12px;
  }

  .exam-meta {
    gap: 6px;
    margin-top: 6px;
    font-size: 12px;
  }

  .bar {
    gap: 8px;
    margin-top: 12px;
  }

  .bar-btn {
    font-size: 13px;
    border-radius: 6px;
    padding: 0 14px;
    line-height: 32px;
    height: 32px;
  }

  .title-row .count {
    font-size: 12px;
  }

  .tip {
    margin: 4px 0 8px;
  }

  .field-col {
    margin-top: 10px;
  }

  .textarea {
    margin-top: 5px;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 13px;
    height: 70px;
  }

  .model-dlg-btn {
    max-width: 100px;
    padding: 0 10px;
  }

  .edit-dialog {
    width: 480px;
    max-width: calc(100vw - 32px);
  }

  .edit-textarea {
    padding-bottom: 26px;
  }

  .edit-label {
    font-size: 12px;
    margin: 10px 0 4px;
  }

  .edit-preview {
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 13px;
  }

  .edit-ill {
    border-radius: 6px;
    margin-bottom: 6px;
  }
}

/* 横屏 / 宽窗口（≥900px）：试卷框图与题目列表左右分栏 */
@media (min-width: 900px) {
  .recog-body {
    display: grid;
    grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
    gap: 10px;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px;
    box-sizing: border-box;
  }

  .recog-body .card {
    margin: 0;
    max-width: none;
    min-width: 0;
  }

  .recog-body .exam-card {
    grid-column: 1 / -1;
  }

  .edit-dialog {
    width: 760px;
    max-width: calc(100vw - 48px);
  }
}
