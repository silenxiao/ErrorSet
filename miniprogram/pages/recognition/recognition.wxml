<!-- 弹窗打开期间锁定页面滚动，防止底层界面跟着滚动（滚动穿透） -->
<page-meta page-style="{{(editQuestion || rerecogVisible) ? 'overflow: hidden;' : ''}}" />

<view wx:if="{{error}}" class="card">
  <view class="danger" style="padding:20rpx 0;">{{error}}</view>
</view>

<view wx:if="{{!error && !exam}}" class="card">
  <view class="muted" style="padding:40rpx 0;text-align:center;">加载中…</view>
</view>

<block wx:if="{{exam}}">
  <view class="recog-body">
  <view class="card exam-card">
    <view class="exam-accent" style="background:{{statusColor}};"></view>
    <view class="exam-main">
      <view class="exam-head">
        <view class="exam-title">{{exam.name || ('试卷 #' + exam.id)}}</view>
        <text class="status-pill" style="background:{{statusColor}}1a;color:{{statusColor}};">{{statusText}}</text>
      </view>
      <view class="exam-meta">
        <text class="meta-item">共 {{questionCount}} 题</text>
        <text class="meta-dot">·</text>
        <text class="meta-item">上传于 {{dateText}}</text>
      </view>

      <view class="bar">
        <button wx:if="{{exam.status === 'awaiting_review'}}" class="btn-primary bar-btn" hover-class="none" loading="{{saving}}" bindtap="confirm">二次识别</button>
        <button wx:if="{{exam.status === 'failed' || exam.status === 'completed'}}" class="btn-ghost bar-btn" hover-class="none" loading="{{saving}}" bindtap="openRerecog">重新识别</button>
        <button wx:if="{{polling}}" class="btn-ghost bar-btn" hover-class="none" bindtap="refresh">刷新</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title title-row">
      <text>试卷原图与插图框</text>
      <view class="ill-preview-btn" bindtap="openIllPreview">预览 / 调整插图</view>
    </view>
    <view class="tip muted">页面内仅展示插图位置信息；点击「预览 / 调整插图」后可拖动框体或八向手柄调整插图区域，松手自动保存。</view>
    <bbox-editor
      imageUrl="{{exam.imageUrl}}"
      questions="{{exam.questions}}"
      selectedId="{{selectedId}}"
      onlyIllustrations="{{true}}"
      editable="{{false}}"
      bind:select="onSelect"
      bind:updateillbbox="onUpdateIllBbox"
    />
  </view>

  <view class="card">
    <view class="card-title">题目列表</view>
    <question-tree
      questions="{{exam.questions}}"
      selectedId="{{selectedId}}"
      canReview="{{exam.status === 'awaiting_review'}}"
      bind:select="onSelect"
      bind:addwrong="onAddWrong"
      bind:reset="onReset"
    />
  </view>
  </view>
</block>

<!-- 编辑题目弹窗：二次识别完成后单击题目打开 -->
<view wx:if="{{editQuestion}}" class="mask" bindtap="closeEdit" catchtouchmove="noop">
  <view class="dialog edit-dialog" catchtap="noop">
    <view class="dialog-title">编辑题目：第 {{editQuestion.questionNo}} 题</view>

    <scroll-view scroll-y class="edit-scroll" enhanced="{{true}}" bounces="{{false}}">
    <textarea
      class="textarea edit-textarea"
      value="{{editText}}"
      maxlength="{{-1}}"
      placeholder="题目文本（数学公式用 $...$ 包裹）"
      bindinput="onEditInput"
      auto-height
    />

      <view class="edit-label muted">预览：</view>
      <view class="edit-preview">
        <md-render content="{{editText}}" />
      </view>

      <block wx:if="{{editIlls.length > 0}}">
        <view class="edit-label muted">插图（{{editIlls.length}} 张，按当前 bbox 裁剪）：</view>
        <image
          wx:for="{{editIlls}}"
          wx:key="id"
          class="edit-ill"
          src="{{item.url}}"
          mode="aspectFit"
          style="{{illSizes['e.' + item.id]}}"
          data-key="e.{{item.id}}"
          bindload="onIllLoad"
        />
      </block>
    </scroll-view>

    <view class="dialog-btns">
      <button class="btn-ghost dlg-btn" hover-class="none" bindtap="closeEdit">取消</button>
      <button class="btn-primary dlg-btn" hover-class="none" loading="{{saving}}" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>

<!-- 插图预览与调整：全屏浮层，大图上直接拖动框体/手柄，松手自动保存 -->
<view wx:if="{{illPreviewVisible}}" class="ill-preview">
  <view class="ill-preview-bar">
    <text class="ill-preview-title">预览与调整插图</text>
    <view class="ill-preview-close" bindtap="closeIllPreview">完成</view>
  </view>
  <scroll-view scroll-y class="ill-preview-body">
    <view class="ill-preview-inner">
      <bbox-editor
        imageUrl="{{exam.imageUrl}}"
        questions="{{exam.questions}}"
        selectedId="{{selectedId}}"
        onlyIllustrations="{{true}}"
        editable="{{true}}"
        bind:select="onSelect"
        bind:updateillbbox="onUpdateIllBbox"
      />
    </view>
  </scroll-view>
</view>

<!-- 重新识别弹窗 -->
<view wx:if="{{rerecogVisible}}" class="mask" bindtap="closeRerecog" catchtouchmove="noop">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">重新识别</view>
    <view class="muted" style="margin-bottom:16rpx;">将清除当前识别结果并重新识别整张试卷。</view>

    <view class="field">
      <text class="label">包含插图</text>
      <switch checked="{{rerecogInclude}}" bindchange="onRerecogInclude" color="#165DFF" />
    </view>

    <view class="field-col">
      <text class="label">补充提示词（可选，最多 800 字）</text>
      <textarea class="textarea" value="{{rerecogExtra}}" maxlength="800" placeholder="例如：这是一年级数学卷，注意区分手写答案与印刷题目" bindinput="onRerecogExtra" />
    </view>

    <view class="dialog-btns">
      <button class="btn-ghost dlg-btn" hover-class="none" bindtap="closeRerecog">取消</button>
      <button class="btn-primary dlg-btn" hover-class="none" bindtap="doRerecog">开始识别</button>
      <button class="btn-ghost dlg-btn model-dlg-btn" hover-class="none" bindtap="chooseModel">{{modelName || '选择模型'}}<view class="ico ico-chev-down-p"></view></button>
    </view>
  </view>
</view>
