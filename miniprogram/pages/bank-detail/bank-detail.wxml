<view wx:if="{{loadError}}" class="card">
  <view class="muted" style="padding:30rpx 0;">错题不存在或已被删除</view>
</view>

<block wx:if="{{detail}}">
  <view class="card">
    <view class="row">
      <view class="card-title" style="margin:0;">错题详情</view>
    </view>

    <view class="sec">题目原文</view>
    <view wx:if="{{origText}}" class="answer">
      <md-render content="{{origText}}"></md-render>
      <view wx:if="{{origIlls.length > 0}}" class="ills">
        <image wx:for="{{origIlls}}" wx:for-item="ill" wx:key="id" class="ill-img" src="{{ill.imgUrl}}" mode="aspectFit" style="{{illSizes['q.' + ill.id]}}" data-key="q.{{ill.id}}" bindload="onIllLoad"></image>
      </view>
    </view>
    <view wx:elif="{{questionMissing}}" class="answer muted">原题已删除，且该错题未保存原文快照</view>
    <view wx:elif="{{!question}}" class="answer muted">加载中…</view>
    <view wx:else class="answer muted">—</view>

    <view class="sec">正确答案</view>
    <view class="answer"><md-render content="{{detail.correctAnswer || '—'}}"></md-render></view>

    <view class="sec">AI 分析结果</view>
    <view class="answer"><md-render content="{{detail.analysis || '—'}}"></md-render></view>

    <block wx:if="{{detail.knowledgePoints.length > 0}}">
      <view class="sec">知识点</view>
      <view class="kp-list">
        <text wx:for="{{detail.knowledgePoints}}" wx:key="*this" class="tag tag-kp">{{item}}</text>
      </view>
    </block>

    <view class="sec">备注</view>
    <view class="muted">{{detail.note || '—'}}</view>

    <view class="sec">打卡</view>
    <view class="mark-row">
      <view class="mark-btn" data-result="correct" bindtap="mark"><view class="ico ico-like"></view>做对</view>
      <view class="mark-btn" data-result="wrong" bindtap="mark"><view class="ico ico-dislike"></view>做错</view>
      <view class="del-link" bindtap="del">删 除</view>
      <text class="mark-count">做对 {{detail.correctCount}} 次 · 做错 {{detail.wrongCount}} 次</text>
    </view>
  </view>
</block>

