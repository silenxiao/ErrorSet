.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 底部留白，避免打卡行被底部横条（Home Indicator）压住 */
.card {
  padding-bottom: 80rpx;
}

/* 小节标题：蓝色竖条 + 加粗深色文字，醒目区分各区块 */
.sec {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 24rpx 0 10rpx;
}

.sec::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #1677ff;
}

.answer {
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-word;
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
  border-radius: 10rpx;
  padding: 16rpx;
}

.ills {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ill-img {
  width: 100%;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
}

/* 打卡行：做对/做错/删除 + 次数 */
.mark-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 28rpx;
  margin-top: 32rpx;
}

.mark-btn {
  font-size: 28rpx;
  color: #1677ff;
}

.mark-btn:active {
  opacity: 0.6;
}

.del-link {
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
  border-radius: 10rpx;
  padding: 8rpx 28rpx;
  font-size: 26rpx;
}

.del-link:active {
  background: #fff1f0;
}

.mark-count {
  margin-left: auto;
  color: #8c8c8c;
  font-size: 26rpx;
}

.field {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  background: #fff;
}

.input {
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.dlg-btn {
  flex: 1;
  margin: 0;
  border-radius: 10rpx;
  line-height: 72rpx;
  height: 72rpx;
  font-size: 28rpx;
}
