.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 底部留白，避免打卡行被底部横条（Home Indicator）压住 */
.card {
  padding-bottom: 80rpx;
}

/* 小节标题：蓝色竖条 + 加粗深色文字，醒目区分各区块 */
.sec {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin: 24rpx 0 10rpx;
}

.sec::before {
  content: "";
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: var(--primary);
}

.answer {
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-word;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx;
}

.ills {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 知识点标签：自动换行排布 */
.kp-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  row-gap: 10rpx;
}

.tag-kp {
  background: var(--primary-light);
  color: var(--primary);
}

.ill-img {
  /* 宽高由 bindload 计算的行内样式控制（按图片实际尺寸显示），此处只管外观 */
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
  background: var(--bg);
}

/* 打卡行：做对/做错/删除 + 次数 */
.mark-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 32rpx;
}

.mark-btn {
  display: inline-flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--primary);
  padding: 8rpx 4rpx;
}

.mark-btn:active {
  opacity: 0.6;
}

.del-link {
  color: var(--danger);
  border: 1rpx solid rgba(245, 63, 63, 0.35);
  border-radius: 12rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
}

.del-link:active {
  background: rgba(245, 63, 63, 0.06);
}

.mark-count {
  margin-left: auto;
  color: var(--text-3);
  font-size: 26rpx;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .card {
    padding-bottom: 40px;
  }

  .sec {
    gap: 5px;
    font-size: 14px;
    margin: 12px 0 5px;
  }

  .sec::before {
    width: 3px;
    height: 13px;
    border-radius: 2px;
  }

  .answer {
    font-size: 14px;
    border-radius: 6px;
    padding: 8px;
  }

  .ills {
    margin-top: 6px;
    gap: 6px;
  }

  .kp-list {
    row-gap: 5px;
  }

  .ill-img {
    border-radius: 6px;
  }

  .mark-row {
    gap: 10px;
    margin-top: 16px;
  }

  .mark-btn {
    font-size: 14px;
  }

  .del-link {
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 13px;
  }

  .mark-count {
    font-size: 13px;
  }
}
