.page {
  padding: 24rpx 20rpx 48rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-sm {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.err-box {
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.err-msg {
  color: #cf1322;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.model-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.model-enabled {
  border-color: #91caff;
  background: #f0f7ff;
}

.model-main {
  flex: 1;
  min-width: 0;
}

.model-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.tag-active {
  background: #e6f9ec;
  color: #23a55a;
}

.model-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-top: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}

.input {
  border: 1rpx solid #e2e5ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #e2e5ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.select-value {
  font-size: 30rpx;
  color: #1f2329;
}

.select-placeholder {
  font-size: 30rpx;
  color: #a9aeb8;
}

.arrow {
  color: #a9aeb8;
  font-size: 36rpx;
  line-height: 1;
}

.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.form-btns button {
  flex: 1;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .page {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
    padding: 12px 10px 24px;
  }

  .toolbar {
    gap: 10px;
    margin-bottom: 10px;
  }

  .btn-sm {
    height: 36px;
    padding: 0 12px;
    font-size: 14px;
    border-radius: 8px;
  }

  .err-box {
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 10px;
  }

  .err-msg {
    font-size: 13px;
    margin-bottom: 4px;
  }

  .empty {
    padding: 40px 0;
  }

  .empty-icon {
    font-size: 36px;
    margin-bottom: 8px;
  }

  .model-card {
    gap: 10px;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 8px;
  }

  .model-title-row {
    gap: 4px;
  }

  .model-name {
    font-size: 15px;
  }

  .model-sub {
    margin-top: 3px;
  }

  .model-actions {
    gap: 4px;
  }

  .form-card {
    border-radius: 10px;
    padding: 16px 12px;
    margin-top: 16px;
  }

  .form-title {
    font-size: 16px;
    margin-bottom: 12px;
  }

  .field {
    margin-bottom: 14px;
  }

  .label {
    font-size: 13px;
    margin-bottom: 6px;
  }

  .input {
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 15px;
  }

  .select-box {
    border-radius: 8px;
    padding: 10px 12px;
  }

  .select-value,
  .select-placeholder {
    font-size: 15px;
  }

  .arrow {
    font-size: 18px;
  }

  .form-btns {
    gap: 10px;
    margin-top: 4px;
  }
}


.tag-system {
  background: #e8f1ff;
  color: #1677ff;
}
