.page {
  padding: 24rpx 20rpx 48rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-sm {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.err-box {
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.err-msg {
  color: #cf1322;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.model-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.model-enabled {
  border-color: #91caff;
  background: #f0f7ff;
}

.model-main {
  flex: 1;
  min-width: 0;
}

.model-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.tag-active {
  background: #e6f9ec;
  color: #23a55a;
}

.model-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-top: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}

.input {
  border: 1rpx solid #e2e5ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #e2e5ea;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.select-value {
  font-size: 30rpx;
  color: #1f2329;
}

.select-placeholder {
  font-size: 30rpx;
  color: #a9aeb8;
}

.arrow {
  color: #a9aeb8;
  font-size: 36rpx;
  line-height: 1;
}

.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.form-btns button {
  flex: 1;
}
