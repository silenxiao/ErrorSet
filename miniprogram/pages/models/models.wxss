/* 模型管理页：model-card/model-enabled/err-box/empty 等复用 app.wxss 全局类 */
.page {
  padding: 24rpx 20rpx 48rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-sm {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.model-main {
  flex: 1;
  min-width: 0;
}

.model-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.model-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.tag-active {
  background: rgba(0, 180, 42, 0.12);
  color: var(--success);
}

.tag-system {
  background: var(--primary-light);
  color: var(--primary);
}

.model-sub {
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.model-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

/* 测试进行中：整列降透明度，避免同时点多个模型 */
.model-actions .testing {
  opacity: 0.5;
}

/* 测试结果行：可用显示延迟，不可用显示原因 */
.test-result {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.test-ok {
  color: var(--success);
}

.test-fail {
  color: var(--danger);
}

.form-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-top: 32rpx;
  box-shadow: var(--shadow-card);
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 表单字段：纵向 label（与共享 .field 横向布局不同） */
.form-card .field {
  display: block;
  margin-bottom: 28rpx;
}

.form-card .label {
  display: block;
  width: auto;
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.input {
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: var(--text-1);
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.select-value {
  font-size: 30rpx;
  color: var(--text-1);
}

.select-placeholder {
  font-size: 30rpx;
  color: var(--text-3);
}

.form-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.form-btns button {
  flex: 1;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .page {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
    padding: 12px 10px 24px;
  }

  .toolbar {
    gap: 10px;
    margin-bottom: 10px;
  }

  .btn-sm {
    height: 36px;
    padding: 0 12px;
    font-size: 14px;
    border-radius: 8px;
  }

  .model-title-row {
    gap: 4px;
  }

  .model-name {
    font-size: 15px;
  }

  .model-sub {
    margin-top: 3px;
  }

  .model-actions {
    gap: 4px;
  }

  .test-result {
    margin-top: 4px;
    font-size: 12px;
  }

  .form-card {
    border-radius: 12px;
    padding: 16px 12px;
    margin-top: 16px;
  }

  .form-title {
    font-size: 16px;
    margin-bottom: 12px;
  }

  .form-card .field {
    margin-bottom: 14px;
  }

  .form-card .label {
    font-size: 13px;
    margin-bottom: 6px;
  }

  .input {
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 15px;
  }

  .select-box {
    border-radius: 8px;
    padding: 10px 12px;
  }

  .select-value,
  .select-placeholder {
    font-size: 15px;
  }

  .form-btns {
    gap: 10px;
    margin-top: 4px;
  }
}
