.page {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  background: var(--card);
  min-height: 100vh;
}

.section {
  margin-bottom: 36rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.req {
  color: var(--danger);
  font-size: 30rpx;
  margin-right: 6rpx;
  line-height: 1;
}

.label {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
}

/* 科目下拉框 */
.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  background: #fff;
}

.select-value {
  font-size: 30rpx;
  color: var(--text-1);
}

/* 答案 / 分析结果展示框 */
.ans-box {
  position: relative;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: #fff;
  padding: 24rpx 68rpx 24rpx 24rpx;
  min-height: 160rpx;
  box-sizing: border-box;
}

.edit-icon {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  padding: 8rpx;
  line-height: 1;
}

.preview-area {
  min-height: 120rpx;
}

.ph {
  font-size: 28rpx;
  color: var(--text-3);
  line-height: 1.6;
}

/* 编辑态文本域（复用框样式，去掉外框避免双框） */
.box-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  box-sizing: border-box;
}

.box-textarea.tall {
  min-height: 320rpx;
}

.box-textarea.note {
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  height: 160rpx;
}

/* AI 分析按钮：主色浅底描边，左对齐 */
.ai-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.ai-row .ai-btn {
  margin: 0;
}

.model-btn {
  width: auto;
  max-width: 300rpx;
  padding: 18rpx 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  margin: 0 0 36rpx;
  padding: 18rpx 0;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid var(--primary);
  border-radius: 16rpx;
  line-height: 1.4;
}

.ai-btn::after {
  border: none;
}

.ai-btn:active {
  background: rgba(22, 93, 255, 0.18);
}

/* 底部 取消 / 确定 */
.footer {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn-sm {
  width: 220rpx;
  margin: 0;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .page {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
    padding: 16px 16px 24px;
  }

  .ai-row {
    gap: 8px;
    margin-bottom: 18px;
  }

  .model-btn {
    max-width: 150px;
    padding: 9px 12px;
    font-size: 14px;
  }

  .section {
    margin-bottom: 18px;
  }

  .label-row {
    margin-bottom: 8px;
  }

  .req {
    font-size: 15px;
    margin-right: 3px;
  }

  .label {
    font-size: 15px;
  }

  .select-box {
    border-radius: 8px;
    padding: 11px 13px;
  }

  .select-value {
    font-size: 15px;
  }

  .arrow {
    font-size: 15px;
  }

  .ans-box {
    border-radius: 8px;
    padding: 12px 34px 12px 12px;
    min-height: 80px;
  }

  .edit-icon {
    top: 10px;
    right: 11px;
    font-size: 16px;
    padding: 4px;
  }

  .preview-area {
    min-height: 60px;
  }

  .ph {
    font-size: 14px;
  }

  .box-textarea {
    min-height: 60px;
    font-size: 14px;
  }

  .box-textarea.tall {
    min-height: 160px;
  }

  .box-textarea.note {
    border-radius: 8px;
    padding: 12px;
    height: 80px;
  }

  .ai-btn {
    width: 110px;
    margin: 0 0 18px;
    padding: 9px 0;
    font-size: 14px;
    border-radius: 8px;
  }

  .footer {
    gap: 12px;
    margin-top: 24px;
  }

  .btn-sm {
    width: 110px;
  }
}

