.page {
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.section {
  margin-bottom: 32rpx;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.label {
  font-size: 30rpx;
  color: var(--text-1);
  font-weight: 500;
}

.count {
  font-size: 24rpx;
  color: var(--text-3);
}

.box-textarea {
  width: 100%;
  min-height: 240rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  box-sizing: border-box;
}

.ph {
  color: var(--text-3);
}

/* 我的留言历史 */
.fb-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.fb-item:last-child {
  border-bottom: none;
}

.fb-content {
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.fb-time {
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .page {
    max-width: 740px;
    margin: 0 auto;
    width: 100%;
    padding: 16px 16px 24px;
  }

  .section {
    margin-bottom: 16px;
  }

  .label-row {
    margin-bottom: 8px;
  }

  .label {
    font-size: 15px;
  }

  .count {
    font-size: 12px;
  }

  .box-textarea {
    min-height: 120px;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
  }

  .fb-item {
    padding: 10px 0;
  }

  .fb-content {
    font-size: 14px;
  }

  .fb-time {
    font-size: 12px;
    margin-top: 4px;
  }
}
