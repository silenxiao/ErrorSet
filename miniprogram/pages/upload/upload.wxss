/* 上传区：白底虚线大卡片（与 Web 端 UploadPanel 一致） */
.uploader {
  border: 2rpx dashed var(--border);
  border-radius: 16rpx;
  padding: 48rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: var(--bg);
  transition: border-color 0.2s ease;
}

.uploader:active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.uploader-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--text-1);
  font-weight: 500;
}

.preview {
  position: relative;
}

.preview-img {
  width: 100%;
  display: block;
  margin: 0 auto;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
}

.preview .preview-remove {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(29, 33, 41, 0.55);
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.field-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.submit-row .submit-grow {
  flex: 1;
  min-width: 0;
}

.model-btn {
  flex-shrink: 0;
  max-width: 280rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 88rpx;
  font-size: 28rpx;
}

.exam-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.exam-row:last-child {
  border-bottom: none;
}

/* 行按压反馈 */
.exam-row-hover {
  background: var(--bg);
}

.exam-main {
  flex: 1;
  min-width: 0;
}

.exam-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.exam-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.exam-btns {
  display: flex;
  gap: 8rpx;
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .uploader {
    padding: 24px 10px;
    border-radius: 8px;
    gap: 4px;
  }

  .uploader-text {
    margin-top: 4px;
    font-size: 14px;
  }

  .preview-img {
    border-radius: 8px;
  }

  .preview .preview-remove {
    top: 6px;
    right: 6px;
    padding: 2px 8px;
    border-radius: 5px;
  }

  .submit-row {
    gap: 8px;
    margin-top: 16px;
  }

  .model-btn {
    max-width: 140px;
    line-height: 44px;
    font-size: 14px;
  }

  .exam-row {
    padding: 10px 0;
  }

  .exam-name {
    font-size: 14px;
    margin-bottom: 3px;
  }

  .exam-side {
    gap: 5px;
  }

  .exam-btns {
    gap: 4px;
  }
}
