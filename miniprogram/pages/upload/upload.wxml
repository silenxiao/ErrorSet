<page-meta page-style="{{editing ? 'overflow:hidden;' : ''}}" />
<view class="card">
  <view class="card-title">上传试卷</view>

  <view class="uploader" bindtap="chooseImage" wx:if="{{!previewImage}}">
    <view class="ico ico-upload"></view>
    <view class="uploader-text">选择或拍照，编辑后上传</view>
    <view class="muted">JPG/PNG/WebP，≤10MB，一张图 = 一份试卷</view>
  </view>

  <view wx:if="{{previewImage}}" class="preview">
    <image class="preview-img" src="{{previewImage}}" mode="aspectFit" style="{{previewStyle}}" bindload="onPreviewLoad" bindtap="reeditImage"></image>
    <view class="text-btn" bindtap="reeditImage">重新编辑</view>
    <view class="text-btn danger preview-remove" bindtap="clearImage">移除</view>
  </view>

  <view class="field">
    <text class="label">年级</text>
    <picker mode="selector" range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="onGrade">
      <view class="field-value picker">{{gradeOptions[gradeIndex]}}<view class="ico ico-chev-down"></view></view>
    </picker>
  </view>

  <view class="field">
    <text class="label">试卷名称</text>
    <input class="input" value="{{name}}" placeholder="默认取图片名，无文件名或拍照时取日期时间" bindinput="onName" />
  </view>

  <view class="field">
    <text class="label">包含插图</text>
    <switch checked="{{includeIllustrations}}" bindchange="onInclude" color="#165DFF" />
    <text class="muted" style="margin-left:8rpx;">开=识别题目和插图（更慢更贵）</text>
  </view>

  <view class="submit-row">
    <button class="btn-primary submit submit-grow" hover-class="none" loading="{{uploading}}" disabled="{{editing || uploading || !previewImage}}" bindtap="upload">上传并开始识别</button>
    <button class="btn-ghost model-btn" hover-class="none" bindtap="chooseModel">{{modelName || '选择模型'}}<view class="ico ico-chev-down-p"></view></button>
  </view>
</view>

<view class="card">
  <view class="card-title">历史试卷</view>

  <view wx:if="{{error && error !== 'empty'}}" class="err-box">
    <view class="err-msg">加载失败：{{error}}</view>
    <view class="err-hint">后端地址：{{backendBase}}（请确认后端已启动，且开发者工具已勾选「不校验合法域名」）</view>
    <view class="text-btn danger" bindtap="retry">点击重试</view>
  </view>

  <view wx:if="{{loading}}" class="muted" style="padding:20rpx 0;">加载中…</view>
  <view wx:if="{{!loading && !error && exams.length === 0}}" class="empty">
    <view class="ico ico-inbox"></view>
    <view class="muted">暂无试卷，上传第一张试卷照片吧</view>
  </view>

  <view wx:for="{{exams}}" wx:key="id" class="exam-row" hover-class="exam-row-hover" hover-stay-time="80">
    <view class="exam-main" bindtap="openExam" data-id="{{item.id}}">
      <view class="exam-name">{{item.name}}</view>
      <view class="muted">题目数 {{item.questionCount}} · {{item.createdAtText}}</view>
    </view>
    <view class="exam-side">
      <text class="tag" style="background:{{item.statusColor}}1a;color:{{item.statusColor}};">{{item.statusText}}</text>
      <view class="exam-btns">
        <view class="text-btn" data-id="{{item.id}}" bindtap="openExam">打开</view>
        <view class="text-btn danger" data-id="{{item.id}}" bindtap="delExam">删除</view>
      </view>
    </view>
  </view>
</view>

<image-editor src="{{editorSrc}}" bind:confirm="confirmImageEdit" bind:cancel="cancelImageEdit" />
