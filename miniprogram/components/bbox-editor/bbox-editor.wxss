.available { width:100%; display:flex; justify-content:center; }
.editor {
  position: relative;
  width: 100%;
  line-height: 0;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  overflow: hidden;
}

.paper {
  width: 100%;
  display: block;
  height: 100%;
}

/* 图片加载骨架 */
.paper-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: var(--bg);
  line-height: 1.4;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid var(--primary-light);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sk-text {
  font-size: 24rpx;
  color: var(--text-3);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 题目框：常态主色；选中主色加粗 + 浅蓝底（与 Web 端一致）；低置信警示橙 */
.bbox {
  position: absolute;
  border: 2rpx solid var(--primary);
  border-radius: 6rpx;
  box-sizing: border-box;
}

.bbox.sel {
  border-width: 4rpx;
  background: rgba(22, 93, 255, 0.1);
}

.bbox.susp {
  border-color: var(--warning);
}

.blabel {
  position: absolute;
  left: 4rpx;
  top: -30rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.3;
  box-shadow: 0 2rpx 6rpx rgba(22, 93, 255, 0.3);
}

/* 可疑题目标签用警示橙区分（替代 ⚠ 字符） */
.bbox.susp .blabel {
  background: var(--warning);
  box-shadow: 0 2rpx 6rpx rgba(255, 125, 0, 0.35);
}

.handle {
  position: absolute;
  /* 命中区域 48rpx：手指才能按准；可见圆点由 ::after 画，保持 22rpx 视觉大小 */
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  border: none;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
}

.handle::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  transform: translate(-50%, -50%);
  background: #fff;
  border: 3rpx solid var(--primary);
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(22, 93, 255, 0.35);
}

.illbox {
  position: absolute;
  border: 2rpx dashed var(--text-3);
  border-radius: 6rpx;
  box-sizing: border-box;
  /* 插图框位于题目框上层，点按/拖动优先作用于插图 */
  z-index: 3;
}

.illbox.illsel {
  border-color: var(--primary);
  background: rgba(22, 93, 255, 0.1);
  z-index: 4;
}

.illlabel {
  position: absolute;
  left: 2rpx;
  top: -24rpx;
  font-size: 18rpx;
  color: #fff;
  background: var(--text-3);
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1.3;
}

.empty {
  text-align: center;
  color: var(--text-3);
  padding: 60rpx 0;
  font-size: 26rpx;
}

