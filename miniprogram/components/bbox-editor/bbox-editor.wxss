.editor {
  position: relative;
  width: 100%;
  line-height: 0;
  background: #f7f8fa;
  border: 1rpx solid #eef0f3;
  border-radius: 14rpx;
  overflow: hidden;
}

.paper {
  width: 100%;
  display: block;
}

/* 图片加载骨架 */
.paper-skeleton {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #f7f8fa;
  line-height: 1.4;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #d9e2f0;
  border-top-color: #1677ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.sk-text {
  font-size: 24rpx;
  color: #999;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.bbox {
  position: absolute;
  border: 2rpx solid #1677ff;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.bbox.sel {
  border-color: #fa8c16;
  border-width: 4rpx;
  background: rgba(250, 140, 22, 0.12);
}

.bbox.susp {
  border-color: #faad14;
}

.blabel {
  position: absolute;
  left: 4rpx;
  top: -30rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: #1677ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.3;
  box-shadow: 0 2rpx 6rpx rgba(22, 119, 255, 0.3);
}

.bbox.sel .blabel {
  background: #fa8c16;
  box-shadow: 0 2rpx 6rpx rgba(250, 140, 22, 0.35);
}

.handle {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  background: #fff;
  border: 3rpx solid #fa8c16;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
}

.illbox {
  position: absolute;
  border: 2rpx dashed #8c8c8c;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.illbox.illsel {
  border-color: #fa8c16;
  background: rgba(250, 140, 22, 0.1);
}

.illlabel {
  position: absolute;
  left: 2rpx;
  top: -24rpx;
  font-size: 18rpx;
  color: #fff;
  background: #8c8c8c;
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1.3;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}
