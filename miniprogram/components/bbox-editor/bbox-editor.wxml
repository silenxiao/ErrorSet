<view class="editor" id="editor" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
  <image wx:if="{{imageUrl}}" class="paper" src="{{imageUrl}}" mode="widthFix" bindload="onImgLoad" binderror="onImgError"></image>
  <view wx:if="{{imageUrl && !imgLoaded}}" class="paper-skeleton">
    <view class="spinner"></view>
    <text class="sk-text">原图加载中…</text>
  </view>

  <!-- 题目 bbox 叠加层 -->
  <view
    wx:for="{{boxes}}"
    wx:key="id"
    class="bbox {{item.selected ? 'sel' : ''}} {{item.suspicious ? 'susp' : ''}}"
    style="{{item.style}}"
    data-id="{{item.id}}"
    data-mode="move"
    bindtouchstart="onHandleStart"
    bindtap="onTapBox"
  >
    <text class="blabel">{{item.no}}</text>

    <block wx:if="{{item.selected}}">
      <view
        wx:for="{{handles}}"
        wx:for-item="h"
        wx:key="mode"
        class="handle"
        style="left:{{h.fx}}%;top:{{h.fy}}%;"
        data-mode="{{h.mode}}"
        catchtouchstart="onHandleStart"
      ></view>
    </block>
  </view>

  <!-- 插图 bbox（展示用，点击选中所属题目） -->
  <view
    wx:for="{{boxes}}"
    wx:for-item="b"
    wx:key="id"
  >
    <view
      wx:for="{{b.ills}}"
      wx:for-item="ill"
      wx:key="id"
      class="illbox {{ill.selected ? 'illsel' : ''}}"
      style="{{ill.style}}"
      data-pid="{{b.id}}"
      bindtap="onTapIll"
    >
      <text class="illlabel">{{ill.type}}</text>
    </view>
  </view>

  <view wx:if="{{!imageUrl}}" class="empty">暂无图片</view>
</view>
