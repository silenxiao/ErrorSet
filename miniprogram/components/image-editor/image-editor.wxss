.mask { position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; }
.dialog { position:relative; z-index:1; width:calc(100% - 32px); max-height:calc(100vh - 32px); background:#fff; border-radius:12px; padding:16px; box-sizing:border-box; }
.title { font-size:18px; font-weight:600; }
.hint { font-size:12px; color:#86909c; margin:8px 0 16px; }
.stage { display:flex; justify-content:center; align-items:center; padding:12px 0; }
.picture { position:relative; }
.image { position:absolute; left:50%; top:50%; }
.crop { position:absolute; border:2px solid #165dff; background:rgba(22,93,255,.1); box-sizing:border-box; }
.handle { position:absolute; width:28px; height:28px; transform:translate(-50%,-50%); z-index:2; }
.handle::after { content:''; position:absolute; left:8px; top:8px; width:12px; height:12px; border:2px solid #165dff; background:#fff; border-radius:50%; box-sizing:border-box; }
.actions {
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:16px;
  padding-top:16px;
  border-top:1px solid #e5e6eb;
}
.actions .action {
  display:flex;
  align-items:center;
  justify-content:center;
  flex:1;
  min-width:0;
  height:44px;
  line-height:44px;
  padding:0 4px;
  margin:0;
  box-sizing:border-box;
  border:1px solid #dce5f5;
  border-radius:8px;
  background:#f0f5ff;
  color:#165dff;
  font-size:13px;
  font-weight:500;
  white-space:nowrap;
}
.actions .action::after { border:none; }
.actions .cancel { background:#f7f8fa; border-color:#e5e6eb; color:#4e5969; }
.actions .confirm { background:#165dff; border-color:#165dff; color:#fff; font-weight:600; }
.actions .action-pressed { background:#e8edf5; }
.actions .confirm-pressed { background:#0e42b8; }
.actions .action[disabled] { background:#f2f3f5; border-color:#e5e6eb; color:#a9aeb8; }
.actions .confirm[disabled] { background:#94b5ff; border-color:#94b5ff; color:#fff; }
/* 保持画布在视口内并盖在弹窗下面，避免屏幕外画布被停止渲染。 */
.export { position:absolute; left:50%; top:50%; width:1px; height:1px; z-index:0; pointer-events:none; }
