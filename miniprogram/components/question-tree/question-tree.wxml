<view class="tree">
  <view wx:if="{{items.length === 0}}" class="empty">暂无题目</view>

  <view
    wx:for="{{items}}"
    wx:key="id"
    class="qitem {{item.selected ? 'sel' : ''}}"
    style="margin-left: {{item.depth * 28}}rpx;"
    data-id="{{item.id}}"
    bindtap="onSelect"
  >
    <view class="qbadge {{item.selected ? 'sel' : ''}}">{{item.no}}</view>

    <view class="qbody">
      <view class="qhead">
        <text class="tag" style="background:{{item.statusColor}}1a;color:{{item.statusColor}};">{{item.statusText}}</text>
        <text wx:if="{{item.suspicious}}" class="tag" style="background:#faad141a;color:#fa8c16;">可疑</text>
        <text wx:if="{{item.manual}}" class="tag" style="background:#8c8c8c1a;color:#666;">已手动调整</text>
        <text wx:if="{{item.illCount > 0}}" class="tag" style="background:#722ed11a;color:#722ed1;">含插图 ×{{item.illCount}}</text>
      </view>

      <view class="qtext">
        <md-render content="{{item.text}}" />
      </view>

      <view class="qactions" catchtap="noop">
        <view class="qacts-l">
          <view class="act-btn primary" data-id="{{item.id}}" catchtap="onAddWrong">加入错题库</view>
          <view wx:if="{{item.illCount > 0}}" class="act-btn" data-id="{{item.id}}" catchtap="onReset">重置插图位置</view>
        </view>
        <text class="edit-hint">{{item.canEdit ? '单击可编辑试题' : '二次识别后可编辑试题'}}</text>
      </view>
    </view>
  </view>
</view>
