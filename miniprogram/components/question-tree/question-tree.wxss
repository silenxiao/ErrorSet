.tree {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.qitem {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 14rpx;
  background: #fff;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.qitem.sel {
  border-color: #fa8c16;
  background: #fffbe6;
}

/* 题号徽标 */
.qbadge {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #555;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qbadge.sel {
  background: #fa8c16;
  color: #fff;
}

.qbody {
  flex: 1;
  min-width: 0;
}

.qhead {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.qtext {
  font-size: 27rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

.qactions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

/* 操作按钮：圆角胶囊，按压反馈 */
.act-btn {
  font-size: 24rpx;
  color: #555;
  padding: 10rpx 22rpx;
  border: 1rpx solid #e2e5ea;
  border-radius: 999rpx;
  background: #fff;
  line-height: 1.3;
}

.act-btn:active {
  background: #f2f3f5;
}

.act-btn.primary {
  color: #1677ff;
  border-color: #bcd9ff;
  background: #f0f6ff;
}

.act-btn.primary:active {
  background: #e0ecff;
}
