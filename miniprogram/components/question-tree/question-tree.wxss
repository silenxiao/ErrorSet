.tree {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty {
  text-align: center;
  color: var(--text-3);
  padding: 40rpx 0;
  font-size: 26rpx;
}

.qitem {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  background: #fff;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

/* 选中态：主色描边 + 浅蓝底（与 Web 端 QuestionList 一致） */
.qitem.sel {
  border-color: var(--primary);
  background: var(--primary-light);
}

/* 题号徽标 */
.qbadge {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg);
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qbadge.sel {
  background: var(--primary);
  color: #fff;
}

.qbody {
  flex: 1;
  min-width: 0;
}

.qhead {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.qtext {
  font-size: 27rpx;
  color: var(--text-1);
  line-height: 1.6;
  word-break: break-word;
}

.qactions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.qacts-l {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

/* 右下角编辑提示 */
.edit-hint {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 操作按钮：圆角胶囊，按压反馈 */
.act-btn {
  font-size: 24rpx;
  color: var(--text-2);
  padding: 10rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: #fff;
  line-height: 1.3;
}

.act-btn:active {
  background: var(--bg);
}

.act-btn.primary {
  color: var(--primary);
  border-color: var(--primary);
  background: var(--primary-light);
}

.act-btn.primary:active {
  background: rgba(22, 93, 255, 0.18);
}

/* ===== Pad / 大屏适配（数值 ≈ rpx/2，还原手机设计尺寸） ===== */
@media (min-width: 500px) {
  .tree {
    gap: 8px;
  }

  .empty {
    padding: 20px 0;
    font-size: 13px;
  }

  .qitem {
    gap: 8px;
    padding: 10px;
    border-radius: 8px;
  }

  .qbadge {
    width: 28px;
    height: 28px;
    font-size: 12px;
  }

  .qhead {
    gap: 4px;
    margin-bottom: 5px;
  }

  .qtext {
    font-size: 14px;
  }

  .qactions {
    gap: 6px;
    margin-top: 8px;
  }

  .qacts-l {
    gap: 6px;
  }

  .edit-hint {
    font-size: 11px;
  }

  .act-btn {
    font-size: 12px;
    padding: 5px 11px;
  }
}
