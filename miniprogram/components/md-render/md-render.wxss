/* Markdown 渲染容器：内部由 <rich-text> 以内联样式 HTML 渲染，
   具体排版样式写在 JS 生成的 HTML 中，外层 scroll-view 允许宽表格横向滚动。 */
.md {
  width: 100%;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1f2329;
  word-break: break-word;
}

/* Pad / 大屏：字号改用固定 px（内部 rich-text 本就是 px 内联样式，仅兜底字号需覆盖） */
@media (min-width: 500px) {
  .md {
    font-size: 14px;
  }
}

