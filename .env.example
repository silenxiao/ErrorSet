# Vision Provider（见 PROJECT_SPEC.md §23）
GLOBAL_PROVIDER=qwen
GLOBAL_MODEL=qwen-vl-max

LOCAL_PROVIDER=openai
LOCAL_MODEL=gpt-4o-mini

QWEN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
AMD_API_KEY=

# 应用设置
# 后端 Docker 构建使用的 pip 源（仅构建时生效；境内服务器可按需修改）
#BACKEND_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# 前端/管理后台开发服务器地址（CORS）
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]

# 登录鉴权（生产环境务必修改 JWT_SECRET）
JWT_SECRET=errorset-dev-secret-change-me
JWT_EXPIRE_DAYS=30

# setup_server.sh 每次按固定地址生成 TRUSTED_PROXY_CIDRS，覆盖下方值。
# 专用网络前三段；如与现有网络冲突，部署前修改。
PROXY_NETWORK_PREFIX=172.30.86

# 限流只信任这些代理的转发链；填写实际 nginx 地址，勿填写客户端网段或 0.0.0.0/0。
# 后端须以 --no-proxy-headers 启动，由应用统一校验转发链。
TRUSTED_PROXY_CIDRS=[]

# 首次启动（用户表为空时）播种的管理员账号；首次部署脚本生成随机密码；已有 .env 首次上线须设置 12–72 字符密码
SEED_ADMIN_USERNAME=xiaohui
SEED_ADMIN_PASSWORD=123456

# 容器端口发布方式（默认容器直接占宿主 80/8081）。
# HTTPS 域名模式由 setup_server.sh --with-domain 自动改为回环监听（80/443 让给宿主机 nginx），一般无需手改：
#WEB_PUBLISH=80:80
#ADMIN_PUBLISH=8081:80
