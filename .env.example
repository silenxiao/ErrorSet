# Vision Provider（见 PROJECT_SPEC.md §23）
GLOBAL_PROVIDER=qwen
GLOBAL_MODEL=qwen-vl-max

LOCAL_PROVIDER=openai
LOCAL_MODEL=gpt-4o-mini

QWEN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ZHIPU_API_KEY=
AMD_API_KEY=

# 应用设置
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# 前端/管理后台开发服务器地址（CORS）
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]

# 登录鉴权（生产环境务必修改 JWT_SECRET）
JWT_SECRET=errorset-dev-secret-change-me
JWT_EXPIRE_DAYS=30

# 首次启动（用户表为空时）播种的管理员账号；生产环境务必在 .env 覆盖密码
SEED_ADMIN_USERNAME=xiaohui
SEED_ADMIN_PASSWORD=123456

# 容器端口发布方式（默认容器直接占宿主 80/8081）。
# HTTPS 域名模式由 setup_server.sh --with-domain 自动改为回环监听（80/443 让给宿主机 nginx），一般无需手改：
#WEB_PUBLISH=80:80
#ADMIN_PUBLISH=8081:80
